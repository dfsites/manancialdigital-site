# Site estático (Astro) — manancialdigital.app (KingHost / Apache)
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# Redirecionamentos permanentes. O QR code impresso aponta para /visitantes.
Redirect 301 /visitantes /primeira-visita/
Redirect 301 /visitantes/ /primeira-visita/

<IfModule mod_rewrite.c>
RewriteEngine On
# HTTPS e host único (sem www); o desafio do Let's Encrypt fica fora do redirecionamento
RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://manancialdigital.app%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
<FilesMatch "\.(html|xml|ics)$">
  Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
<FilesMatch "\.(js|css|woff2|webp|png|jpg|svg|ico)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/xml text/calendar image/svg+xml
</IfModule>
